<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Material3Gallery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OsuXaml.Material3\OsuXaml.Material3.csproj" />
    <ProjectReference Include="$(OsuXamlDirectory)src/OsuXaml.Generator/OsuXaml.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every .xaml file is compiled by osu-xaml's source generator. -->
    <AdditionalFiles Include="**\*.xaml" />
  </ItemGroup>
  <!-- Writes completion schemas for the XAML to obj/osu-xaml/ after each build. -->
  <Import Project="$(OsuXamlDirectory)src/OsuXaml.Schema/OsuXaml.Schema.targets" />
</Project>
